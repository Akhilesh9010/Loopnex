PORT=5000
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
LOCAL_DATA_FALLBACK=true
# Optional comma-separated frontend origins for a separately hosted frontend.
# Same-origin deployment does not need this setting.
# FRONTEND_ORIGIN=https://example.com

# Optional: set this to use shared MongoDB Atlas storage instead of the local fallback.
# If Atlas is unavailable, the local fallback keeps this development copy usable.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/loopnex?retryWrites=true&w=majority

# Optional: enable Gemini-powered listing copy suggestions. Keep this key private.
# Create a key in Google AI Studio, then add it to this local .env and Render's Environment settings.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
