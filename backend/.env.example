PORT=5000
HOST=127.0.0.1
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
LOCAL_DATA_FALLBACK=true

# Optional: set this to use shared MongoDB Atlas storage instead of the local fallback.
# If Atlas is unavailable, the local fallback keeps this development copy usable.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/loopnex?retryWrites=true&w=majority
